{
  "name": "koishi-plugin-miyako-chatluna-image-resolver",
  "version": "1.1.0",
  "description": "Miyako ChatLuna image resolver with keyword search, reverse image search, managed local cache, and optional WebDAV sync.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yabo083/koishi-plugin-miyako-chatluna-image-resolver.git"
  },
  "bugs": {
    "url": "https://github.com/yabo083/koishi-plugin-miyako-chatluna-image-resolver/issues"
  },
  "homepage": "https://github.com/yabo083/koishi-plugin-miyako-chatluna-image-resolver#readme",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "keywords": [
    "koishi",
    "koishi-plugin",
    "chatluna",
    "image",
    "resolver",
    "webdav",
    "miyako",
    "reverse-image-search"
  ],
  "author": "yabo",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "koishi-console build .",
    "test": "npm run build && node --test tests/*.test.cjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "koishi": "^4.18.0",
    "koishi-plugin-chatluna-character": "*"
  },
  "peerDependenciesMeta": {
    "koishi-plugin-chatluna-character": {
      "optional": true
    }
  },
  "dependencies": {
    "@langchain/core": "^0.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@koishijs/client": "^5.30.11",
    "@types/node": "^22.7.5",
    "typescript": "^5.6.2"
  },
  "yakumo": {
    "client": "./client/index.ts"
  },
  "koishi": {
    "public": [
      "dist"
    ],
    "description": {
      "zh": "Miyako ChatLuna 图片解析器：搜图、以图搜图、统一缓存管理与 WebDAV 同步。"
    },
    "service": {
      "optional": [
        "chatluna",
        "chatluna_storage",
        "puppeteer",
        "console"
      ]
    }
  }
}
