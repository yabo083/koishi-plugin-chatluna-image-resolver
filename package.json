{
  "name": "koishi-plugin-miyako-chatluna-media-resolver",
  "version": "1.5.0",
  "description": "Miyako ChatLuna media resolver with SerpApi image search, Google Lens reverse search, QQ media links, public URL delivery, and SQLite-indexed cache.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yabo083/koishi-plugin-chatluna-image-resolver.git"
  },
  "bugs": {
    "url": "https://github.com/yabo083/koishi-plugin-chatluna-image-resolver/issues"
  },
  "homepage": "https://github.com/yabo083/koishi-plugin-chatluna-image-resolver#readme",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "dist",
    "client",
    "docs/skills",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "keywords": [
    "koishi",
    "koishi-plugin",
    "chatluna",
    "image",
    "media",
    "file",
    "resolver",
    "webdav",
    "miyako",
    "reverse-image-search"
  ],
  "author": "yabo",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "koishi-console build .",
    "test": "npm run build && node --test tests/*.test.cjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "koishi": "^4.18.0",
    "koishi-plugin-chatluna-character": "*"
  },
  "peerDependenciesMeta": {
    "koishi-plugin-chatluna-character": {
      "optional": true
    }
  },
  "dependencies": {
    "@langchain/core": "^0.3.0",
    "archiver": "^8.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@koishijs/client": "^5.30.11",
    "@types/archiver": "^7.0.0",
    "@types/node": "^22.7.5",
    "typescript": "^5.6.2"
  },
  "yakumo": {
    "client": "./client/index.ts"
  },
  "koishi": {
    "public": [
      "dist"
    ],
    "description": {
      "zh": "Miyako ChatLuna 媒体/文件解析器：SerpApi 搜图与反搜、QQ 媒体直链、公网 URL 分发、SQLite 缓存索引。"
    },
    "service": {
      "optional": [
        "chatluna",
        "server",
        "console",
        "database"
      ]
    }
  }
}
